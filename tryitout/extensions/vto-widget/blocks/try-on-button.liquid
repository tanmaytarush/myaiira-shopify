<div class="myaiira-vto" data-product-id="{{ product.id }}">
  <button type="button" class="myaiira-vto__button">
    {{ block.settings.button_label }}
  </button>
</div>

{% schema %}
{
  "name": "Virtual Try-On",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Try it on"
    }
  ]
}
{% endschema %}
