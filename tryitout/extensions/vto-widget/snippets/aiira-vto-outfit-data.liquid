{%- comment -%}
  Builds outfit + alternatives JSON from Shopify catalog only.
  Assigns: aiira_outfit_json, aiira_outfit_alternatives_json

  Params:
  - outfit_products: array of products (look pieces)
  - swap_pool: optional extra products for piece swapping
  - alternative_look_collections: optional collections (each = one full look preset)
  - fallback_product: optional — uses this product's image gallery when outfit_products is empty
{%- endcomment -%}

{%- assign aiira_outfit_json = nil -%}
{%- assign aiira_outfit_alternatives_json = nil -%}

{%- if outfit_products != blank and outfit_products.size > 0 -%}
  {%- capture aiira_outfit_json -%}[{%- assign item_first = true -%}{%- for piece in outfit_products -%}{%- if piece.featured_image -%}{%- unless item_first -%},{%- endunless -%}{%- assign item_first = false -%}{%- render 'aiira-vto-piece-json', piece: piece -%}{%- endif -%}{%- endfor -%}]{%- endcapture -%}
  {%- if aiira_outfit_json == '[]' -%}
    {%- assign aiira_outfit_json = nil -%}
  {%- endif -%}
{%- endif -%}

{%- if aiira_outfit_json == nil and fallback_product != blank -%}
  {%- capture aiira_outfit_json -%}[{%- assign item_first = true -%}{%- assign media_index = 0 -%}{%- for media in fallback_product.media limit: 12 -%}{%- if media.media_type == 'image' -%}{%- unless item_first -%},{%- endunless -%}{%- assign item_first = false -%}{%- render 'aiira-vto-media-json', media: media, product: fallback_product, index: media_index -%}{%- assign media_index = media_index | plus: 1 -%}{%- endif -%}{%- endfor -%}]{%- endcapture -%}
  {%- if aiira_outfit_json == '[]' -%}
    {%- assign aiira_outfit_json = nil -%}
  {%- endif -%}
{%- endif -%}

{%- capture aiira_alt_body -%}
{%- assign preset_first = true -%}
{%- if alternative_look_collections != blank -%}
  {%- for look_collection in alternative_look_collections -%}
    {%- if look_collection.products_count > 0 -%}
      {%- unless preset_first -%},{%- endunless -%}
      {%- assign preset_first = false -%}
      {"name":{{ look_collection.title | json }},"items":[{%- assign item_first = true -%}{%- for piece in look_collection.products limit: 12 -%}{%- if piece.featured_image -%}{%- unless item_first -%},{%- endunless -%}{%- assign item_first = false -%}{%- render 'aiira-vto-piece-json', piece: piece -%}{%- endif -%}{%- endfor -%}]}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if swap_pool != blank and swap_pool.size > 0 -%}
  {%- unless preset_first -%},{%- endunless -%}
  {"name":"Additional pieces","items":[{%- assign item_first = true -%}{%- for piece in swap_pool -%}{%- if piece.featured_image -%}{%- unless item_first -%},{%- endunless -%}{%- assign item_first = false -%}{%- render 'aiira-vto-piece-json', piece: piece -%}{%- endif -%}{%- endfor -%}]}
{%- endif -%}
{%- endcapture -%}

{%- assign aiira_alt_body = aiira_alt_body | strip -%}
{%- if aiira_alt_body != blank -%}
  {%- assign aiira_outfit_alternatives_json = aiira_alt_body | prepend: '[' | append: ']' -%}
{%- endif -%}
